.family-page {
  padding-top: 24rpx;
}

.family-hero {
  margin-bottom: 28rpx;
}

.family-sub {
  margin-top: 8rpx;
}

.family-progress {
  padding: 34rpx;
  border-radius: 36rpx;
}

.family-progress-label {
  font-size: 24rpx;
  color: rgba(255, 253, 248, 0.7);
}

.family-progress-count {
  font-size: 32rpx;
  font-weight: 700;
}

.family-track {
  height: 14rpx;
  margin-top: 20rpx;
  border-radius: 7rpx;
  background: rgba(255, 252, 245, 0.16);
  overflow: hidden;
}

.family-fill {
  height: 100%;
  border-radius: 7rpx;
  background: var(--gold);
  transition: width 240ms ease;
}

.family-progress-note {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: rgba(255, 253, 248, 0.7);
}

.family-btn {
  margin-top: 26rpx;
}

.stage-grid {
  display: flex;
  margin-top: 20rpx;
}

.stage-mini {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: var(--card);
  box-shadow: 0 10rpx 26rpx rgba(30, 42, 39, 0.05);
}

.stage-mini + .stage-mini {
  margin-left: 12rpx;
}

.stage-mini-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.stage-mini-label {
  font-size: 21rpx;
  color: var(--muted);
}

.stage-mini-count {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--jade);
}

.stage-mini-track {
  height: 8rpx;
  margin-top: 10rpx;
  border-radius: 4rpx;
  background: #ece4d5;
  overflow: hidden;
}

.stage-mini-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--jade);
  transition: width 240ms ease;
}

.family-actions {
  display: flex;
  margin-top: 20rpx;
}

.family-action {
  flex: 1;
}

.family-action + .family-action {
  margin-left: 16rpx;
}

.section-head {
  margin: 40rpx 4rpx 16rpx;
}

.members-card {
  padding: 8rpx 28rpx;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.member-row:first-child {
  border-top: none;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: var(--jade-soft);
  color: var(--jade);
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.member-name {
  font-size: 29rpx;
  font-weight: 600;
}

.member-status {
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #f1eadc;
  font-size: 20rpx;
  color: var(--muted);
}

.recent-card {
  padding: 8rpx 28rpx;
}

.recent-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.recent-row:first-child {
  border-top: none;
}

.recent-term {
  display: block;
  font-size: 31rpx;
  font-weight: 600;
}

.recent-meaning {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.recent-duration {
  margin-right: 14rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.recent-play {
  width: 34rpx;
  height: 34rpx;
}

.empty {
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 36rpx;
}

.reset-btn {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  padding: 18rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.family-note {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #a39a8c;
}
