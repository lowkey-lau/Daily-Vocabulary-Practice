<view class="page stats" wx:if="{{stats}}">
  <view class="row">
    <image
      class="eyebrow-icon"
      src="/assets/icons/chart.png"
      mode="aspectFit"
    />
    <text class="eyebrow">学习统计</text>
  </view>
  <view class="title-xl">一点点，</view>
  <view class="title-xl">也在往前走。</view>

  <view class="stat-grid stats-top">
    <view class="stat-card">
      <image class="stat-icon" src="/assets/icons/book.png" mode="aspectFit" />
      <view class="stat-value">{{stats.learned}}</view>
      <view class="stat-label">累计学习</view>
    </view>
    <view class="stat-card">
      <image
        class="stat-icon"
        src="/assets/icons/trophy.png"
        mode="aspectFit"
      />
      <view class="stat-value">{{stats.mastered}}</view>
      <view class="stat-label">已掌握</view>
    </view>
    <view class="stat-card">
      <image class="stat-icon" src="/assets/icons/fire.png" mode="aspectFit" />
      <view class="stat-value">{{stats.streak}}</view>
      <view class="stat-label">连续天数</view>
    </view>
  </view>

  <view class="card chart-card">
    <view class="row-between">
      <view class="row">
        <image
          class="section-icon"
          src="/assets/icons/chart.png"
          mode="aspectFit"
        />
        <text class="title-md">近 7 天</text>
      </view>
      <text class="caption">
        共 {{stats.totalAnswered}} 题 · 正确率 {{stats.accuracy}}%
      </text>
    </view>

    <view class="chart">
      <view class="chart-col" wx:for="{{stats.days}}" wx:key="key">
        <view class="chart-bar-wrap">
          <view
            class="chart-bar {{item.isToday ? 'today' : ''}}"
            style="height: {{item.height}}%"
          ></view>
        </view>
        <text class="chart-count">{{item.answered}}</text>
        <text class="chart-label {{item.isToday ? 'today-label' : ''}}">
          {{item.label}}
        </text>
      </view>
    </view>

    <view class="chart-empty" wx:if="{{stats.totalAnswered === 0}}">
      <image
        class="chart-empty-icon"
        src="/assets/icons/seedling.png"
        mode="aspectFit"
      />
      <text>还没有记录，去学几个词吧。</text>
    </view>
  </view>

  <view class="card stats-note-card">
    <view class="row-between">
      <view class="row">
        <image
          class="section-icon"
          src="/assets/icons/memo.png"
          mode="aspectFit"
        />
        <text>错词本</text>
      </view>
      <text class="detail-value">{{stats.wrongCount}} 个</text>
    </view>
    <button class="secondary-btn stats-btn" bindtap="goWrong">
      <image class="btn-icon" src="/assets/icons/memo.png" mode="aspectFit" />
      <text>去复习错词</text>
    </button>
  </view>

  <button class="primary-btn stats-main-btn" bindtap="goPractice">
    <image
      class="btn-icon"
      src="/assets/icons/sparkles.png"
      mode="aspectFit"
    />
    <text>去学几个词</text>
  </button>
</view>
