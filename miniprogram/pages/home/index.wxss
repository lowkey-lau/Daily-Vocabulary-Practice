.home {
  padding-top: 24rpx;
}

.home-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.streak-pill {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  background: var(--jade-soft);
  color: var(--jade);
}

.streak-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
}

.streak-number {
  font-size: 34rpx;
  font-weight: 700;
}

.streak-label {
  margin-left: 4rpx;
  font-size: 22rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 34rpx 34rpx;
  border-radius: 36rpx;
}

.hero-card::after {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 252, 245, 0.08);
  content: "";
}

.hero-eyebrow {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 253, 248, 0.72);
}

.hero-badge {
  position: relative;
  z-index: 1;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 245, 0.12);
  font-size: 22rpx;
  color: rgba(255, 253, 248, 0.86);
}

.hero-number-row {
  display: flex;
  align-items: baseline;
  margin-top: 22rpx;
}

.hero-number {
  font-size: 100rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.hero-divider {
  margin: 0 10rpx;
  font-size: 44rpx;
  color: rgba(255, 253, 248, 0.45);
}

.hero-total {
  font-size: 44rpx;
  color: rgba(255, 253, 248, 0.7);
}

.hero-unit {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 253, 248, 0.65);
}

.hero-track {
  height: 14rpx;
  margin-top: 26rpx;
  border-radius: 7rpx;
  background: rgba(255, 252, 245, 0.16);
  overflow: hidden;
}

.hero-fill {
  height: 100%;
  border-radius: 7rpx;
  background: var(--gold);
  transition: width 240ms ease;
}

.hero-note {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 253, 248, 0.72);
}

.hero-btn {
  margin-top: 30rpx;
}

.section-head {
  margin: 40rpx 4rpx 18rpx;
}

.book-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.book-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 118rpx;
  height: 118rpx;
  margin-right: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1b6b62, #0e4f4a);
  color: #fffdf8;
  font-size: 56rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.book-progress-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.book-progress-text {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: var(--muted);
  white-space: nowrap;
}

.quick-grid {
  display: flex;
  margin-top: 24rpx;
}

.quick-card {
  flex: 1;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: var(--card);
  box-shadow: 0 16rpx 40rpx rgba(30, 42, 39, 0.06);
  transition: transform 180ms ease, opacity 180ms ease;
}

.quick-card + .quick-card {
  margin-left: 18rpx;
}

.quick-icon {
  display: block;
  width: 46rpx;
  height: 46rpx;
}

.quick-title {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.quick-caption {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.demo-note {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #a39a8c;
}
