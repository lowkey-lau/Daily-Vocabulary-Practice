.wrongbook {
  padding-top: 24rpx;
}

.wrong-summary {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.wrong-list {
  margin-top: 24rpx;
  padding: 8rpx 28rpx 28rpx;
}

.wrong-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.wrong-row:first-child {
  border-top: none;
}

.wrong-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #f1eadc;
  font-size: 20rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.wrong-term {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.wrong-reading {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--jade);
}

.wrong-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.wrong-meaning {
  font-size: 26rpx;
  color: var(--ink);
}

.wrong-count {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--coral);
}

.wrong-btn {
  margin-top: 24rpx;
}

.empty-caption {
  margin-top: 8rpx;
}

.empty-btn {
  margin-top: 36rpx;
}
