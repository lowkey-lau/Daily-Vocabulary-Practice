.result {
  padding-top: 16rpx;
}

.result-hero {
  position: relative;
  padding: 20rpx 0 12rpx;
  text-align: center;
}

.result-party {
  display: block;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 2rpx;
  animation: party-float 640ms cubic-bezier(0.2, 0.9, 0.2, 1) both;
}

.stars {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 18rpx 0 8rpx;
}

.star {
  width: 68rpx;
  height: 68rpx;
  margin: 0 8rpx;
  opacity: 0.22;
  animation: star-pop 460ms cubic-bezier(0.2, 0.9, 0.2, 1) both;
}

.stars .star:nth-child(1) {
  animation-delay: 40ms;
}

.stars .star:nth-child(2) {
  animation-delay: 120ms;
}

.stars .star:nth-child(3) {
  animation-delay: 200ms;
}

.star.on {
  opacity: 1;
}

.accuracy {
  font-size: 108rpx;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: -2rpx;
  color: var(--jade);
}

.percent {
  margin-left: 4rpx;
  font-size: 42rpx;
}

.accuracy-label {
  font-size: 24rpx;
  color: var(--muted);
}

.result-message {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.result-stats {
  margin-top: 28rpx;
}

.result-stats .stat-card {
  background: var(--card);
  box-shadow: 0 12rpx 30rpx rgba(30, 42, 39, 0.05);
}

.result-detail {
  margin-top: 24rpx;
}

.detail-row {
  padding: 16rpx 0;
  font-size: 27rpx;
}

.detail-row + .detail-row {
  border-top: 2rpx solid var(--line);
}

.detail-value {
  font-weight: 600;
  color: var(--jade);
}

.wrong-card {
  margin-top: 24rpx;
}

.wrong-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 2rpx solid var(--line);
}

.wrong-term {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.wrong-reading {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--jade);
  letter-spacing: 1rpx;
}

.wrong-meaning {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--muted);
  text-align: right;
}

.result-actions {
  margin-top: 36rpx;
}

.action-btn {
  margin-bottom: 18rpx;
}

.home-link {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
  color: var(--muted);
  font-weight: 500;
}

.empty-caption {
  margin-top: 8rpx;
}

.empty-btn {
  margin-top: 36rpx;
}

@keyframes party-float {
  0% {
    opacity: 0;
    transform: translateY(14rpx) rotate(-8deg) scale(0.8);
  }
  70% {
    opacity: 1;
    transform: translateY(-4rpx) rotate(4deg) scale(1.04);
  }
  100% {
    opacity: 1;
    transform: translateY(0) rotate(0) scale(1);
  }
}

@keyframes star-pop {
  0% {
    transform: scale(0.2) rotate(-12deg);
  }
  70% {
    transform: scale(1.12) rotate(3deg);
  }
  100% {
    transform: scale(1) rotate(0);
  }
}
