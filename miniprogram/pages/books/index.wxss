.books {
  padding-top: 24rpx;
}

.books-hero {
  margin-bottom: 32rpx;
}

.books-sub {
  margin-top: 14rpx;
}

.book-main {
  padding: 22rpx;
}

.book-main-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 250rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #1b6b62, #0e4f4a);
  color: #fffdf8;
}

.cover-char {
  font-size: 104rpx;
  font-weight: 700;
  line-height: 1;
}

.cover-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 253, 248, 0.72);
}

.book-main-body {
  padding: 26rpx 8rpx 6rpx;
}

.book-desc {
  margin-top: 6rpx;
}

.book-bar-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.book-bar-text {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: var(--muted);
  white-space: nowrap;
}

.book-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.book-meta-dot {
  margin: 0 10rpx;
}

.book-btn {
  margin-top: 24rpx;
}

.section-head {
  margin: 40rpx 4rpx 16rpx;
}

.upcoming-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
}

.upcoming-card + .upcoming-card {
  margin-top: 14rpx;
}

.upcoming-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: var(--jade-soft);
  color: var(--jade);
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.upcoming-body {
  min-width: 0;
}

.upcoming-title {
  font-size: 29rpx;
  font-weight: 600;
}

.upcoming-tag {
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  background: #f1eadc;
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
}

.demo-note {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: #a39a8c;
}
